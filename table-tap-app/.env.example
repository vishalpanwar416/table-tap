# Environment Variables - Table Tap

# ============================================
# SUPABASE CONFIGURATION
# ============================================
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# ENCRYPTION
# ============================================
REACT_APP_ENCRYPTION_KEY=your-32-character-encryption-key

# ============================================
# SENTRY ERROR TRACKING
# ============================================
# Get DSN from: https://sentry.io/settings/[org]/projects/[project]/keys/
REACT_APP_SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/789012
REACT_APP_SENTRY_ENVIRONMENT=production
REACT_APP_VERSION=1.0.1

# Optional: Enable Sentry in development
# REACT_APP_SENTRY_DEBUG=true

# ============================================
# APPLICATION SETTINGS
# ============================================
# Set to 'production', 'staging', or 'development'
NODE_ENV=production

# ============================================
# NOTES
# ============================================
# - Never commit this file with real values
# - Use .env.local for local development
# - Configure production values in Vercel dashboard
# - Rotate keys quarterly for security
# - Service role key should NEVER be in frontend .env
