{
  "buildCommand": "npm run build:app",
  "outputDirectory": "table-tap-app/build",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/((?!static|favicon.ico|manifest.json|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}